# gpumod-8xaq: raw llama-server stderr logs may contain personal paths
docs/research/**/phase2_results/*.bench.log

# gpumod-8viu: raw llama-server stderr + capture logs may contain personal paths
docs/research/**/phase2_smoke*.bench.log
docs/research/**/phase2_smoke*_results.txt

# Timestamped script backups (e.g. *.bak-20260618T221121Z) — may contain host paths
scripts/*.bak-*

# Machine-specific env for gpumod-mode-restore.sh (host paths); template is .env.example
scripts/gpumod-mode-restore.env

# Local agent-session transcripts (contain cwd / host paths)
sessions/

# Local PII blocklist for scripts/check-pii.sh (never commit — holds sensitive strings)
.pii-blocklist
