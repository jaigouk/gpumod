// bpftrace script: count and size syscalls of interest during a llama-server
// model load. Filters by comm "llama-server" so it doesn't catch background noise.
//
// Usage:
//   sudo bpftrace docs/research/20260525_oom_protection_findings/trace_load.bt \
//       > docs/research/20260525_oom_protection_findings/runs/<NAME>.bpftrace.txt
//
// Stop with Ctrl-C after the load finishes (after /health returns 200).

BEGIN
{
    printf("trace_load.bt started — Ctrl-C when load complete\n");
    printf("# event\tts_ns\tpid\tcomm\tsize_bytes\textra\n");
}

tracepoint:syscalls:sys_enter_mmap
/comm == "llama-server"/
{
    printf("mmap\t%lld\t%d\t%s\t%lu\tprot=%lx flags=%lx\n",
        nsecs, pid, comm, args->len, args->prot, args->flags);
}

tracepoint:syscalls:sys_enter_mlock
/comm == "llama-server"/
{
    printf("mlock\t%lld\t%d\t%s\t%lu\n", nsecs, pid, comm, args->len);
}

tracepoint:syscalls:sys_enter_mlock2
/comm == "llama-server"/
{
    printf("mlock2\t%lld\t%d\t%s\t%lu\tflags=%lx\n",
        nsecs, pid, comm, args->len, args->flags);
}

tracepoint:syscalls:sys_enter_madvise
/comm == "llama-server" && (args->behavior == 3 || args->behavior == 4 || args->behavior == 14)/
{
    // 3 = MADV_WILLNEED, 4 = MADV_DONTNEED, 14 = MADV_HUGEPAGE
    printf("madvise\t%lld\t%d\t%s\t%lu\tbehavior=%d\n",
        nsecs, pid, comm, args->len, args->behavior);
}

tracepoint:syscalls:sys_enter_brk
/comm == "llama-server"/
{
    @brk_count[comm] = count();
}

END
{
    printf("# bpftrace done\n");
    print(@brk_count);
}
