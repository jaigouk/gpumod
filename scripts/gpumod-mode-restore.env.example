# gpumod-mode-restore.env — machine-specific overrides for gpumod-mode-restore.sh
#
# Copy this file to "gpumod-mode-restore.env" (gitignored) only if your gpumod
# checkout is NOT at the default $HOME/AI/gpumod. The tracked script sources the
# copy automatically if present, otherwise it uses the $HOME-based defaults.
#
# GPUMOD_DIR="$HOME/AI/gpumod"                       # gpumod repo root
# GPUMOD_BIN="${GPUMOD_DIR}/.venv/bin/gpumod"        # gpumod entrypoint
# GPUMOD_MCP_READY_TIMEOUT=120                        # seconds to wait for gpumod-mcp
