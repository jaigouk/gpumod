[Unit]
Description=gpumod MCP Server
After=network.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
WorkingDirectory={{ working_dir }}
ExecStart={{ python_bin }} -m gpumod.mcp_main
Restart=on-failure
RestartSec=5
Environment=PATH={{ venv_bin }}:/usr/local/bin:/usr/bin:/bin
{% if host is defined %}Environment="GPUMOD_MCP_HOST={{ host }}"
{% endif %}{% if port is defined %}Environment="GPUMOD_MCP_PORT={{ port }}"
{% endif %}
[Install]
WantedBy=default.target
