[Unit]
Description=gpumod MCP Server
After=network.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
WorkingDirectory={{ working_dir }}
ExecStart={{ python_bin }} -m gpumod.mcp_main
Restart=on-failure
RestartSec=5
Environment=PATH={{ venv_bin }}:/usr/local/bin:/usr/bin:/bin
Environment="GPUMOD_MCP_TRANSPORT={{ transport | default('streamable-http') }}"
Environment="GPUMOD_MCP_HOST={{ host | default('127.0.0.1') }}"
Environment="GPUMOD_MCP_PORT={{ port | default(8808) }}"

[Install]
WantedBy=default.target
