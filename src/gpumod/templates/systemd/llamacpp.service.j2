[Unit]
Description={{ service.name }}
After=network.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
Environment="CUDA_VISIBLE_DEVICES={{ settings.cuda_devices | default('0') }}"
{% for key, value in extra_env.items() %}
Environment="{{ key }}={{ value }}"
{% endfor %}
{%- if service.compat %}

# gpumod-l20: ExecStartPre runs `gpumod doctor venv` to short-circuit
# starts when the driver venv's installed packages drift outside the
# declared compat ranges. Rarely set for llamacpp services (the binary
# is C++ not Python) but the branch is present for consistency.
ExecStartPre={{ settings.gpumod_bin | default('gpumod') }} doctor venv --service-id {{ service.id }}
{%- endif %}
{%- if service.preflight_required %}

# gpumod-ecr/gpumod-aeb: ExecStartPre runs `gpumod preflight all` to
# short-circuit starts when model-file, VRAM, or RAM checks fail.
# Catches direct systemctl starts, Restart=on-failure cascades, and
# autostart paths that bypass the Python API safeguard.
ExecStartPre={{ settings.gpumod_bin | default('gpumod') }} preflight all --service-id {{ service.id }}
{%- endif %}

ExecStart={{ settings.llamacpp_bin | default('llama-server') }} \
{%- if unit_vars.models_dir is defined %}
    --models-dir {{ unit_vars.models_dir }} \
{%- if unit_vars.no_models_autoload | default(false) %}
    --no-models-autoload \
{%- endif %}
{%- if unit_vars.models_max is defined %}
    --models-max {{ unit_vars.models_max }} \
{%- endif %}
{%- else %}
    --model {{ unit_vars.model_path }} \
{%- endif %}
    --port {{ service.port }} \
    --host {{ unit_vars.host | default('127.0.0.1') }} \
{%- if unit_vars.context_size is defined or unit_vars.models_dir is not defined %}
    --ctx-size {{ unit_vars.context_size | default(4096) }} \
{%- endif %}
    --n-gpu-layers {{ unit_vars.n_gpu_layers | default(-1) }}
{%- if unit_vars.jinja | default(false) %} \
    --jinja
{%- endif %}
{%- set _fa = unit_vars.flash_attn | default(false) %}
{%- if _fa %} \
    --flash-attn {{ _fa if _fa is string else 'on' }}
{%- endif %}
{%- if unit_vars.preset_file is defined %} \
    --override-kv {{ unit_vars.preset_file }}
{%- endif %}
{%- if unit_vars.extra_args is defined %} \
    {{ unit_vars.extra_args }}
{%- endif %}

Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
