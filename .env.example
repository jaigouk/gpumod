# gpumod configuration — all variables use the GPUMOD_ prefix.
# Copy to .env and uncomment to override defaults.
#
# See docs/getting-started/configuration.md for full details.

# Database
# GPUMOD_DB_PATH=~/.config/gpumod/gpumod.db

# Logging
# GPUMOD_LOG_LEVEL=INFO

# Preflight thresholds (MB)
# GPUMOD_RAM_MIN_FREE_MB=1024
# GPUMOD_RAM_WARN_FREE_MB=4096
# GPUMOD_VRAM_SAFETY_MARGIN_MB=512

# LLM backend for `gpumod plan suggest`
# GPUMOD_LLM_BACKEND=openai
# GPUMOD_LLM_API_KEY=
# GPUMOD_LLM_MODEL=gpt-4o-mini
# GPUMOD_LLM_BASE_URL=

# MCP rate limit (requests/min)
# GPUMOD_MCP_RATE_LIMIT=10
